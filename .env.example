# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# The .env file is ignored by Git and will NEVER be pushed to GitHub.
# ==============================================================================

# Database Connection (Supabase, Firebase, PostgreSQL, MongoDB, etc.)
DATABASE_URL=https://your-database-url.supabase.co
DATABASE_API_KEY=your_public_or_service_key_here

# Supabase Credentials (if using Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Firebase Credentials (if using Firebase via Env)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-project-id

# App Secrets
APP_ENV=development
API_SECRET_KEY=your-secret-key-here
